<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
  <AssemblyName>personal-tools-service</AssemblyName><RootNamespace>PersonalTools</RootNamespace>
  <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
  <InvariantGlobalization>false</InvariantGlobalization><TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  <DBusHandlerTypeName>PersonalTools.Bus.ServiceHandler</DBusHandlerTypeName>
 </PropertyGroup>
 <ItemGroup>
  <FrameworkReference Include="Microsoft.AspNetCore.App"/>
  <PackageReference Include="Tmds.DBus" Version="0.95.1"/>
  <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.1"/>
  <PackageReference Include="Tmds.DBus.Generator" Version="0.95.1" PrivateAssets="all"/>
  <AdditionalFiles Include="../Protocol/io.griplabs.PersonalTools1.xml" Namespace="PersonalTools.Bus" DBusGeneratorMode="Handler" Visibility="public"/>
 </ItemGroup>
</Project>
