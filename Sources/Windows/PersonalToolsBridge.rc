// Version information for PersonalToolsBridge.dll. On 2026-10-27 Smart App Control (enforced on
// this PC) started blocking the bridge built without it, after a Code Integrity policy refresh,
// so the UI ran without the speaker reference; the same code linked with this resource loads.
// Whether the new hash or the metadata made the difference is not known.
#include <winver.h>
VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,6,5,0
PRODUCTVERSION 0,6,5,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Personal Tools"
      VALUE "FileDescription", "Personal Tools audio bridge (speaker reference, EQ setup)"
      VALUE "FileVersion", "0.6.5.0"
      VALUE "InternalName", "PersonalToolsBridge"
      VALUE "OriginalFilename", "PersonalToolsBridge.dll"
      VALUE "ProductName", "Personal Tools"
      VALUE "ProductVersion", "0.6.5.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
