<Window x:Class="PersonalTools.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PersonalTools" Title="Personal Tools">
  <Window.SystemBackdrop><MicaBackdrop/></Window.SystemBackdrop>
  <Grid x:Name="Root">
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition/></Grid.RowDefinitions>
    <Grid x:Name="AppTitleBar" Padding="16,0,0,0" Background="Transparent">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <Image Source="Assets/PersonalTools.png" Width="16" Height="16"/>
        <TextBlock Text="Personal Tools" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"/>
      </StackPanel>
    </Grid>
    <NavigationView x:Name="Navigation" Grid.Row="1" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsTitleBarAutoPaddingEnabled="False"
                    OpenPaneLength="220" CompactModeThresholdWidth="760" ExpandedModeThresholdWidth="960" PaneDisplayMode="Auto"
                    SelectionChanged="Navigate" ItemInvoked="NavigationItemInvoked" DisplayModeChanged="NavigationDisplayModeChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="ClipboardNav" Content="클립보드" Tag="clipboard"><NavigationViewItem.Icon><FontIcon Glyph="&#xE77F;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="창 빠른 전환" Tag="windows"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7C4;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="사운드" Tag="sound"><NavigationViewItem.Icon><FontIcon Glyph="&#xE767;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="자동 HDR" Tag="hdr"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="화면 자동 끄기" Tag="display-idle"><NavigationViewItem.Icon><FontIcon Glyph="&#xE708;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="조명" Tag="lighting"><NavigationViewItem.Icon><FontIcon Glyph="&#xE82F;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem x:Name="BridgeNav" Content="Antigravity 브릿지" Tag="antigravity"><NavigationViewItem.Icon><FontIcon Glyph="&#xE774;"/></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
        <NavigationViewItem Content="진단" Tag="diagnostics"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="앱 종료" Tag="exit" SelectsOnInvoked="False"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7E8;"/></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.FooterMenuItems>
      <Grid>
        <local:ClipboardPage x:Name="ClipsPage"/>
        <local:ClipboardSettingsPage x:Name="ClipSettingsPage" Visibility="Collapsed"/>
        <local:WindowSwitchPage x:Name="SwitchPage" Visibility="Collapsed"/>
        <local:SoundPage x:Name="SoundsPage" Visibility="Collapsed"/>
        <local:HdrPage x:Name="HdrsPage" Visibility="Collapsed"/>
        <local:DisplayIdlePage x:Name="IdlePage" Visibility="Collapsed"/>
        <local:LightingPage x:Name="LightPage" Visibility="Collapsed"/>
        <local:AntigravityPage x:Name="BridgePage" Visibility="Collapsed"/>
        <local:DiagnosticsPage x:Name="DiagPage" Visibility="Collapsed"/>
      </Grid>
    </NavigationView>
  </Grid>
</Window>
