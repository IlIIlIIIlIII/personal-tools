<UserControl x:Class="PersonalTools.AntigravityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="1000" Margin="36,28,36,32" Spacing="16">
      <TextBlock Text="Antigravity 브릿지" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="OpenAI 호환 앱의 요청을 이 PC의 Antigravity CLI로 연결합니다." Style="{StaticResource Lead}"/>
      <Border Style="{StaticResource Card}">
        <StackPanel Spacing="16">
          <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid x:Name="StateBadge" Width="36" Height="36">
              <Ellipse x:Name="StateCircle" Fill="{ThemeResource SystemFillColorSuccessBrush}"/>
              <FontIcon x:Name="StateGlyph" Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="StateTitle" Text="중지됨" Style="{StaticResource SubtitleTextBlockStyle}"/>
              <TextBlock x:Name="StateDetail" Style="{StaticResource CardDescription}" Text="CLI를 확인한 뒤 브릿지를 시작해 주세요."/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button x:Name="StartButton" Content="시작" Click="StartBridge" Style="{ThemeResource AccentButtonStyle}" MinWidth="80"/>
              <Button x:Name="StopButton" Content="중지" Click="StopBridge" MinWidth="80" Visibility="Collapsed"/>
            </StackPanel>
          </Grid>
          <Grid ColumnSpacing="12" RowSpacing="8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Base URL" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12,6">
              <TextBlock x:Name="BaseUrl" Text="http://127.0.0.1:8877/v1" FontFamily="Cascadia Mono, Consolas" FontSize="13" IsTextSelectionEnabled="True"/>
            </Border>
            <Button Grid.Column="2" Click="CopyBaseUrl" ToolTipService.ToolTip="Base URL 복사" AutomationProperties.Name="Base URL 복사" Width="34" Height="32" Padding="0">
              <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
            </Button>
            <TextBlock Grid.Row="1" Text="API 키" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
            <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12,6">
              <TextBlock x:Name="KeyText" FontFamily="Cascadia Mono, Consolas" FontSize="13" IsTextSelectionEnabled="True" TextTrimming="CharacterEllipsis"/>
            </Border>
            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="4">
              <ToggleButton x:Name="RevealKey" Click="RevealKeyClick" ToolTipService.ToolTip="API 키 보기" AutomationProperties.Name="API 키 보기" Width="34" Height="32" Padding="0">
                <FontIcon Glyph="&#xE890;" FontSize="14"/>
              </ToggleButton>
              <Button Click="CopyConnection" ToolTipService.ToolTip="주소와 키를 환경 변수 형식으로 복사" AutomationProperties.Name="연결 주소와 키 복사" Width="34" Height="32" Padding="0">
                <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
              </Button>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <StackPanel Spacing="4">
        <TextBlock Text="CLI" Style="{StaticResource GroupHeader}" Margin="0,8,0,4"/>
        <Border Style="{StaticResource SettingCard}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE756;" FontSize="20"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="Antigravity CLI"/>
              <TextBlock x:Name="CliPathText" Style="{StaticResource CardDescription}" FontFamily="Cascadia Mono, Consolas" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Border x:Name="CliPill" Style="{StaticResource StatusPill}" Padding="10,3" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse x:Name="CliDot" Width="8" Height="8"/><TextBlock x:Name="CliState" FontSize="12"/></StackPanel>
              </Border>
              <Button x:Name="BrowseButton" Content="변경" Click="BrowseCli"/>
              <Button x:Name="CheckButton" Content="확인" Click="CheckCli"/>
              <Button x:Name="LoginButton" Content="CLI 열기" Click="OpenCli"/>
            </StackPanel>
          </Grid>
        </Border>
        <Border Style="{StaticResource SettingCard}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Viewbox Width="20" Height="20" VerticalAlignment="Center">
              <Path Fill="{ThemeResource TextFillColorPrimaryBrush}" Data="M7,1.5 L8.4,5.6 12.5,7 8.4,8.4 7,12.5 5.6,8.4 1.5,7 5.6,5.6 Z M12.6,10.4 L13.2,12 14.8,12.6 13.2,13.2 12.6,14.8 12,13.2 10.4,12.6 12,12 Z"/>
            </Viewbox>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="기본 모델"/>
              <TextBlock Style="{StaticResource CardDescription}" Text="앱이 모델을 지정하지 않으면 이 모델을 씁니다. antigravity는 CLI 기본 모델입니다."/>
            </StackPanel>
            <ComboBox x:Name="ModelBox" Grid.Column="2" IsEditable="True" Width="260" VerticalAlignment="Center" AutomationProperties.Name="기본 모델"/>
          </Grid>
        </Border>
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Text="고급" Style="{StaticResource GroupHeader}" Margin="0,8,0,4"/>
        <Border Style="{StaticResource SettingCard}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE839;" FontSize="20"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="포트"/>
              <TextBlock Style="{StaticResource CardDescription}" Text="브릿지가 중지된 상태에서 바꿀 수 있습니다."/>
            </StackPanel>
            <NumberBox x:Name="PortBox" Grid.Column="2" Minimum="1024" Maximum="65535" Value="8877" Width="140" SpinButtonPlacementMode="Compact" VerticalAlignment="Center" AutomationProperties.Name="포트"/>
          </Grid>
        </Border>
        <Border Style="{StaticResource SettingCard}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE916;" FontSize="20"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="요청 제한 시간 (초)"/>
              <TextBlock Style="{StaticResource CardDescription}" Text="응답이 이 시간 안에 오지 않으면 요청을 끊습니다."/>
            </StackPanel>
            <NumberBox x:Name="TimeoutBox" Grid.Column="2" Minimum="10" Maximum="600" Value="120" Width="140" SpinButtonPlacementMode="Compact" VerticalAlignment="Center" AutomationProperties.Name="요청 제한 시간"/>
          </Grid>
        </Border>
        <Border Style="{StaticResource SettingCard}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE724;" FontSize="20"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="연결 테스트"/>
              <TextBlock x:Name="TestResult" Style="{StaticResource CardDescription}" Text="짧은 메시지를 보내 응답이 오는지 확인합니다." MaxLines="3" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button x:Name="TestButton" Grid.Column="2" Content="테스트" Click="TestBridge" IsEnabled="False" VerticalAlignment="Center"/>
          </Grid>
        </Border>
      </StackPanel>
      <TextBlock Style="{StaticResource Footnote}" Text="텍스트 대화와 스트리밍을 지원합니다. 이미지, 도구 호출, Responses API는 지원하지 않습니다. 요청은 Antigravity 계정의 사용량을 씁니다. 앱을 실행하면 저장된 설정으로 자동 시작하고, 앱을 종료하면 중지됩니다."/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
