<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>PersonalTools</RootNamespace>
    <AssemblyName>PersonalToolsWindows</AssemblyName>
    <Product>Personal Tools</Product>
    <Title>Personal Tools</Title>
    <AssemblyTitle>Personal Tools</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/PersonalTools.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <!-- Set aside for now (2026-10-20 Windows scope): display power, vLLM and the microphone shortcut.
       Auto-HDR came back on 2026-10-21; DisplayPowerModels.cs stays only for the HDR snapshot wire format. -->
  <ItemGroup>
    <Compile Remove="DisplayPowerMonitor.cs;Vllm*.cs;MicrophoneMute.cs" />
    <Page Remove="VllmPage.xaml" />
    <None Remove="DisplayPowerProbe.ps1;VllmStart.py" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Content Update="Assets/PersonalTools.png" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets/PersonalTools.ico" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.6584" />
  </ItemGroup>
  <!-- AudioService P/Invokes the native UI bridge, whose loopback worker is the only source of the
       speaker reference for echo cancellation. Packages get it from `cmake install` (ui\), so a
       publish never replaces it; dev outputs (dotnet build -o build\<name>) copy the native build. -->
  <PropertyGroup>
    <PersonalToolsBridgeDll Condition="'$(PersonalToolsBridgeDll)' == ''">$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)..\..\..\build\windows-native\Sources\Windows\PersonalToolsBridge.dll'))</PersonalToolsBridgeDll>
  </PropertyGroup>
  <Target Name="CopyPersonalToolsBridge" AfterTargets="Build">
    <Warning Condition="!Exists('$(PersonalToolsBridgeDll)')" Text="PersonalToolsBridge.dll not found at $(PersonalToolsBridgeDll). The app falls back to the installed Program Files\PersonalTools\ui copy; without one no speaker reference is captured and echo cancellation does not work. Build build\windows-native first or pass -p:PersonalToolsBridgeDll=&lt;path&gt;." />
    <Copy Condition="Exists('$(PersonalToolsBridgeDll)')" SourceFiles="$(PersonalToolsBridgeDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishPersonalToolsBridge" AfterTargets="Publish" Condition="Exists('$(PersonalToolsBridgeDll)') And !Exists('$(PublishDir)PersonalToolsBridge.dll')">
    <Copy SourceFiles="$(PersonalToolsBridgeDll)" DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
