<UserControl x:Class="PersonalTools.ClipboardPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:PersonalTools">
 <UserControl.Resources>
 <ResourceDictionary>
  <!-- Quick panel tints (docs: claude.ai/artifact/Gu3QaVn4Fz8eBrLxxGoz3V, A안). -->
  <ResourceDictionary.ThemeDictionaries>
   <ResourceDictionary x:Key="Default">
    <SolidColorBrush x:Key="PanelAccentSoftBrush" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.1"/>
    <SolidColorBrush x:Key="PanelAccentStrokeBrush" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.24"/>
    <SolidColorBrush x:Key="PanelFileBrush" Color="#F2C04C"/>
    <SolidColorBrush x:Key="PanelFileSoftBrush" Color="#F2C04C" Opacity="0.13"/>
   </ResourceDictionary>
   <ResourceDictionary x:Key="Light">
    <SolidColorBrush x:Key="PanelAccentSoftBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.08"/>
    <SolidColorBrush x:Key="PanelAccentStrokeBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.22"/>
    <SolidColorBrush x:Key="PanelFileBrush" Color="#8F5B00"/>
    <SolidColorBrush x:Key="PanelFileSoftBrush" Color="#A86B00" Opacity="0.11"/>
   </ResourceDictionary>
   <ResourceDictionary x:Key="HighContrast">
    <SolidColorBrush x:Key="PanelAccentSoftBrush" Color="{ThemeResource SystemColorWindowColor}"/>
    <SolidColorBrush x:Key="PanelAccentStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
    <SolidColorBrush x:Key="PanelFileBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
    <SolidColorBrush x:Key="PanelFileSoftBrush" Color="{ThemeResource SystemColorWindowColor}"/>
   </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <DataTemplate x:Key="FileRow" x:DataType="local:ClipFileRow">
   <Grid ColumnSpacing="8" Height="28" Padding="10,0" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
         BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,0,4">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <FontIcon Glyph="&#xE8A5;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    <TextBlock Grid.Column="2" Text="{x:Bind Size}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="CardTemplate" x:DataType="local:ClipboardCard">
   <Grid Padding="14,12,8,10" RowSpacing="10" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
         BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
         DoubleTapped="CardDoubleTapped" ContextRequested="CardContextRequested" AutomationProperties.Name="{x:Bind Description}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="8" Margin="0,0,6,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <FontIcon Glyph="{x:Bind FormatIcon}" FontSize="14" Foreground="{x:Bind TypeBrush}"/>
     <TextBlock Grid.Column="1" Text="{x:Bind FormatLabel}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
     <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
      <Border Visibility="{x:Bind BadgeVisibility}" CornerRadius="4" Padding="6,1" Background="{x:Bind BadgeBackground}">
       <TextBlock Text="{x:Bind Badge}" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind BadgeForeground}"/>
      </Border>
      <Viewbox Width="12" Height="12" Visibility="{x:Bind TagVisibility}" VerticalAlignment="Center" ToolTipService.ToolTip="이미지 태그 있음">
       <Path Fill="{ThemeResource TextFillColorTertiaryBrush}" Data="M7,1.5 L8.4,5.6 12.5,7 8.4,8.4 7,12.5 5.6,8.4 1.5,7 5.6,5.6 Z M12.6,10.4 L13.2,12 14.8,12.6 13.2,13.2 12.6,14.8 12,13.2 10.4,12.6 12,12 Z"/>
      </Viewbox>
      <FontIcon Glyph="&#xE718;" FontSize="12" Visibility="{x:Bind PinVisibility}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     </StackPanel>
    </Grid>
    <Grid Grid.Row="1" Margin="0,0,6,0">
     <TextBlock Text="{x:Bind Entry.Preview}" FontSize="14" LineHeight="20" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="{x:Bind PreviewLines}" Visibility="{x:Bind TextVisibility}"/>
     <Border Visibility="{x:Bind UrlVisibility}" VerticalAlignment="Top" Padding="12,10" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
             BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <StackPanel Spacing="2">
       <TextBlock Text="{x:Bind UrlHost}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
       <TextBlock Text="{x:Bind Entry.Preview}" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>
     <Border Visibility="{x:Bind ImageVisibility}" CornerRadius="4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <Image Loaded="ThumbnailLoaded" Unloaded="ThumbnailUnloaded" DataContextChanged="ThumbnailDataContextChanged" Stretch="UniformToFill"/>
     </Border>
     <ItemsControl Visibility="{x:Bind FilesVisibility}" ItemsSource="{x:Bind Files}" ItemTemplate="{StaticResource FileRow}" VerticalAlignment="Top"/>
    </Grid>
    <Grid Grid.Row="2" ColumnSpacing="6">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Grid Width="16" Height="16" ToolTipService.ToolTip="{x:Bind Entry.SourceApp}">
      <FontIcon Glyph="&#xE737;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
      <Image Width="16" Height="16" Loaded="AppIconLoaded" DataContextChanged="AppIconDataContextChanged" Unloaded="ThumbnailUnloaded"/>
     </Grid>
     <TextBlock Grid.Column="1" Text="{x:Bind Footer}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
     <Button Grid.Column="2" Style="{StaticResource SubtleIconButton}" Width="26" Height="24" Click="CardMenuClick"
             AutomationProperties.Name="카드 작업" ToolTipService.ToolTip="복사, 미리보기, 모음, 고정, 삭제">
      <FontIcon Glyph="&#xE712;" FontSize="14"/>
     </Button>
    </Grid>
   </Grid>
  </DataTemplate>
  <Style x:Key="CardContainer" TargetType="SelectorItem">
   <Setter Property="Padding" Value="0"/>
   <Setter Property="Margin" Value="0,0,12,12"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="VerticalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="SelectorItem">
    <Grid Background="Transparent">
     <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
      <VisualState x:Name="Normal"/>
      <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="HoverRing.Opacity" Value="1"/></VisualState.Setters></VisualState>
      <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="HoverRing.Opacity" Value="1"/></VisualState.Setters></VisualState>
      <VisualState x:Name="Selected"><VisualState.Setters><Setter Target="SelectionRing.Opacity" Value="1"/></VisualState.Setters></VisualState>
      <VisualState x:Name="PointerOverSelected"><VisualState.Setters><Setter Target="SelectionRing.Opacity" Value="1"/></VisualState.Setters></VisualState>
      <VisualState x:Name="PressedSelected"><VisualState.Setters><Setter Target="SelectionRing.Opacity" Value="1"/></VisualState.Setters></VisualState>
     </VisualStateGroup></VisualStateManager.VisualStateGroups>
     <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
     <Border x:Name="HoverRing" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}" Opacity="0" IsHitTestVisible="False"/>
     <Border x:Name="SelectionRing" CornerRadius="8" BorderThickness="2" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0" IsHitTestVisible="False"/>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Quick panel. Window corners are DWM's small 4 px (ClipboardPanelNative), and
       inner radii follow inner = outer - inset: card 8, inset media 4, selection ring
       12 at a 2 px gap, pills 16 holding 24 px chips of 12. -->
  <Style x:Key="PanelRoundButton" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="0"/>
   <Setter Property="Width" Value="32"/>
   <Setter Property="Height" Value="32"/>
   <Setter Property="CornerRadius" Value="16"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="UseSystemFocusVisuals" Value="True"/>
   <Setter Property="FocusVisualMargin" Value="-2"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
     <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
      <VisualState x:Name="Normal"/>
      <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Hover.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/></VisualState.Setters></VisualState>
      <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Hover.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/></VisualState.Setters></VisualState>
      <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
     </VisualStateGroup></VisualStateManager.VisualStateGroups>
     <Border x:Name="Hover" CornerRadius="{TemplateBinding CornerRadius}" Background="Transparent"/>
     <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}"
                       Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                       VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" AutomationProperties.AccessibilityView="Raw"/>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PanelTabItem" TargetType="SelectorBarItem">
   <Setter Property="Height" Value="24"/>
   <Setter Property="Padding" Value="12,0"/>
   <Setter Property="CornerRadius" Value="12"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="UseSystemFocusVisuals" Value="True"/>
   <Setter Property="FocusVisualMargin" Value="-2"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="SelectorBarItem">
    <Grid x:Name="Root" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
     <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="CombinedStates">
       <VisualState x:Name="UnselectedNormal"/>
       <VisualState x:Name="UnselectedPointerOver"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/><Setter Target="Label.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/></VisualState.Setters></VisualState>
       <VisualState x:Name="UnselectedPressed"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/></VisualState.Setters></VisualState>
       <VisualState x:Name="SelectedNormal"><VisualState.Setters><Setter Target="Chip.Opacity" Value="1"/><Setter Target="Label.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/></VisualState.Setters></VisualState>
       <VisualState x:Name="SelectedPointerOver"><VisualState.Setters><Setter Target="Chip.Opacity" Value="1"/><Setter Target="Label.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/></VisualState.Setters></VisualState>
       <VisualState x:Name="SelectedPressed"><VisualState.Setters><Setter Target="Chip.Opacity" Value="1"/><Setter Target="Label.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/></VisualState.Setters></VisualState>
      </VisualStateGroup>
      <VisualStateGroup x:Name="DisabledStates">
       <VisualState x:Name="Enabled"/>
       <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
      </VisualStateGroup>
     </VisualStateManager.VisualStateGroups>
     <Border x:Name="Chip" Opacity="0" CornerRadius="{TemplateBinding CornerRadius}" Background="{ThemeResource ControlSolidFillColorDefaultBrush}"
             BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"/>
     <TextBlock x:Name="Label" Text="{TemplateBinding Text}" Margin="{TemplateBinding Padding}" FontSize="{TemplateBinding FontSize}"
                Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="PanelFileRow" x:DataType="local:ClipFileRow">
   <Grid ColumnSpacing="8" Height="26">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <FontIcon Glyph="&#xE8A5;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
    <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    <TextBlock Grid.Column="2" Text="{x:Bind Size}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="PanelCardTemplate" x:DataType="local:ClipboardCard">
   <Grid Padding="{x:Bind CardPadding}" RowSpacing="8" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
         BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
         DoubleTapped="CardDoubleTapped" ContextRequested="CardContextRequested"
         PointerEntered="CardPointerEntered" PointerExited="CardPointerExited" PointerCanceled="CardPointerExited"
         AutomationProperties.Name="{x:Bind Description}">
    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="24"/></Grid.RowDefinitions>
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <Border Visibility="{x:Bind BadgeVisibility}" HorizontalAlignment="Left" Height="20" Margin="0,0,0,12" Padding="7,0,8,0" CornerRadius="10" Background="{x:Bind BadgeBackground}">
      <StackPanel Orientation="Horizontal" Spacing="6">
       <Ellipse Width="6" Height="6" Fill="{x:Bind BadgeForeground}" VerticalAlignment="Center"/>
       <TextBlock Text="{x:Bind Badge}" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind BadgeForeground}" VerticalAlignment="Center"/>
      </StackPanel>
     </Border>
     <TextBlock Grid.Row="1" Visibility="{x:Bind TextVisibility}" Text="{x:Bind Entry.Preview}" Margin="{x:Bind TextMargin}"
                FontFamily="{x:Bind PreviewFont}" FontSize="{x:Bind PreviewFontSize}" LineHeight="{x:Bind PreviewLineHeight}" LineStackingStrategy="BlockLineHeight"
                TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="{x:Bind PanelLines}"/>
     <Border Grid.Row="1" Visibility="{x:Bind ImageVisibility}" CornerRadius="4">
      <Image Loaded="ThumbnailLoaded" Unloaded="ThumbnailUnloaded" DataContextChanged="ThumbnailDataContextChanged" Stretch="UniformToFill"/>
     </Border>
     <Grid Grid.Row="1" Visibility="{x:Bind UrlVisibility}" RowSpacing="12">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <Grid ColumnSpacing="10">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Width="32" Height="32" CornerRadius="8" Background="{ThemeResource PanelAccentSoftBrush}">
        <FontIcon Glyph="&#xE71B;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
       </Border>
       <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="{x:Bind UrlHost}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="웹 링크" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
       </StackPanel>
      </Grid>
      <TextBlock Grid.Row="1" Text="{x:Bind Entry.Preview}" FontSize="12" LineHeight="18" LineStackingStrategy="BlockLineHeight"
                 Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="{x:Bind UrlLines}"/>
     </Grid>
     <Grid Grid.Row="1" Visibility="{x:Bind FilesVisibility}" RowSpacing="8">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <Grid ColumnSpacing="10">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Width="32" Height="32" CornerRadius="8" Background="{ThemeResource PanelFileSoftBrush}">
        <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource PanelFileBrush}"/>
       </Border>
       <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="{x:Bind FormatLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{x:Bind TotalSize}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
       </StackPanel>
      </Grid>
      <ItemsControl Grid.Row="1" ItemsSource="{x:Bind Files}" ItemTemplate="{StaticResource PanelFileRow}" VerticalAlignment="Top"/>
     </Grid>
    </Grid>
    <Grid Grid.Row="1" Padding="{x:Bind FooterPadding}" ColumnSpacing="6">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Grid Width="16" Height="16" ToolTipService.ToolTip="{x:Bind Entry.SourceApp}">
      <FontIcon Glyph="&#xE737;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
      <Image Width="16" Height="16" Loaded="AppIconLoaded" DataContextChanged="AppIconDataContextChanged" Unloaded="ThumbnailUnloaded"/>
     </Grid>
     <TextBlock Grid.Column="1" Text="{x:Bind Footer}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
     <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Visibility="{x:Bind HintVisibility, Mode=OneWay}">
      <Border Style="{StaticResource Keycap}" Padding="6,1,6,2" VerticalAlignment="Center">
       <TextBlock Text="Enter" FontSize="11" FontWeight="SemiBold"/>
      </Border>
      <TextBlock Text="붙여넣기" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     </StackPanel>
     <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" Visibility="{x:Bind ActionsVisibility, Mode=OneWay}">
      <Button Style="{StaticResource PanelRoundButton}" Width="24" Height="24" CornerRadius="12" Click="CardPinClick"
              AutomationProperties.Name="{x:Bind PinActionLabel}" ToolTipService.ToolTip="{x:Bind PinActionLabel}">
       <FontIcon Glyph="{x:Bind PinActionGlyph}" FontSize="12"/>
      </Button>
      <Button Style="{StaticResource PanelRoundButton}" Width="24" Height="24" CornerRadius="12" Click="CardMenuClick"
              Background="{ThemeResource SubtleFillColorSecondaryBrush}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
              AutomationProperties.Name="카드 작업" ToolTipService.ToolTip="붙여넣기, 복사, 미리보기, 모음 지정, 삭제">
       <FontIcon Glyph="&#xE712;" FontSize="12"/>
      </Button>
     </StackPanel>
    </Grid>
    <FontIcon Grid.RowSpan="2" Visibility="{x:Bind PinVisibility}" Glyph="&#xE718;" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="0,3,0,0" Foreground="{ThemeResource TextFillColorTertiaryBrush}" AutomationProperties.AccessibilityView="Raw"/>
   </Grid>
  </DataTemplate>
  <Style x:Key="PanelCardContainer" TargetType="ListViewItem">
   <Setter Property="Padding" Value="0"/>
   <Setter Property="Margin" Value="0,0,12,0"/>
   <Setter Property="Width" Value="236"/>
   <Setter Property="MinWidth" Value="0"/>
   <Setter Property="MinHeight" Value="0"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="VerticalContentAlignment" Value="Stretch"/>
   <!-- Selection follows focus, so the outset ring is the focus indicator. -->
   <Setter Property="UseSystemFocusVisuals" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem">
    <Grid Background="Transparent">
     <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
      <VisualState x:Name="Normal"/>
      <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="HoverFill.Opacity" Value="1"/><Setter Target="HoverStroke.Opacity" Value="1"/></VisualState.Setters></VisualState>
      <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="HoverFill.Opacity" Value="1"/><Setter Target="HoverStroke.Opacity" Value="1"/></VisualState.Setters></VisualState>
      <VisualState x:Name="Selected"><VisualState.Setters><Setter Target="SelectedFill.Opacity" Value="1"/><Setter Target="Ring.Opacity" Value="1"/></VisualState.Setters></VisualState>
      <VisualState x:Name="PointerOverSelected"><VisualState.Setters><Setter Target="SelectedFill.Opacity" Value="1"/><Setter Target="Ring.Opacity" Value="1"/></VisualState.Setters></VisualState>
      <VisualState x:Name="PressedSelected"><VisualState.Setters><Setter Target="SelectedFill.Opacity" Value="1"/><Setter Target="Ring.Opacity" Value="1"/></VisualState.Setters></VisualState>
     </VisualStateGroup></VisualStateManager.VisualStateGroups>
     <Border x:Name="HoverFill" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}" Opacity="0"/>
     <Border x:Name="SelectedFill" CornerRadius="8" Background="{ThemeResource ControlFillColorDefaultBrush}" Opacity="0"/>
     <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
     <Border x:Name="HoverStroke" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}" Opacity="0" IsHitTestVisible="False"/>
     <Border x:Name="Ring" Margin="-4" CornerRadius="12" BorderThickness="2" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0" IsHitTestVisible="False"/>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </ResourceDictionary>
 </UserControl.Resources>
 <Border x:Name="PanelChrome" Background="Transparent">
 <Grid x:Name="Surface" Padding="36,28,36,0" KeyDown="PageKeyDown" SizeChanged="SurfaceSizeChanged">
  <Grid.KeyboardAccelerators>
   <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FocusSearchInvoked"/>
  </Grid.KeyboardAccelerators>
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Grid x:Name="MainHeader" Margin="0,0,0,16">
   <TextBlock Text="클립보드" Style="{StaticResource PageTitle}"/>
   <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
    <Button x:Name="PauseButton" Style="{StaticResource SubtleTextButton}" Click="PauseClick" AutomationProperties.Name="기록 일시정지">
     <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon x:Name="PauseGlyph" Glyph="&#xE769;" FontSize="14"/><TextBlock x:Name="PauseLabel" Text="기록 일시정지"/></StackPanel>
    </Button>
    <Button Style="{StaticResource SubtleTextButton}" Click="SettingsClick" AutomationProperties.Name="클립보드 설정">
     <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE713;" FontSize="14"/><TextBlock Text="설정"/></StackPanel>
    </Button>
   </StackPanel>
  </Grid>
  <!-- Quick panel header: search, collections and tools on one row. -->
  <Grid x:Name="PanelHeader" Visibility="Collapsed" Height="32" Margin="0,0,12,12" ColumnSpacing="8">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="300"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/>
   </Grid.ColumnDefinitions>
   <Grid>
    <Border CornerRadius="16" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlElevationBorderBrush}" BorderThickness="1"/>
    <Grid ColumnSpacing="8" Padding="12,0,4,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <TextBox x:Name="PanelQuery" Grid.Column="1" PlaceholderText="검색" TextChanged="QueryChanged" KeyDown="QueryKeyDown" GotFocus="PanelQueryFocusChanged" LostFocus="PanelQueryFocusChanged"
              MaxLength="4000" MinHeight="0" MinWidth="0" Padding="0,5,0,6" BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
              AutomationProperties.Name="클립보드 검색어" AutomationProperties.HelpText="Enter 검색, Shift+Enter AI 검색, Ctrl+F 검색창으로 이동, 아래 화살표 카드로 이동">
      <TextBox.Resources>
       <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
       <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
       <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
       <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
       <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
       <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
      </TextBox.Resources>
     </TextBox>
     <TextBlock x:Name="PanelSearchHint" Grid.Column="2" Text="Ctrl+F" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
     <ToggleButton x:Name="PanelAiToggle" Grid.Column="3" Height="24" MinWidth="0" Padding="8,0,10,0" CornerRadius="12" BorderThickness="0" Background="Transparent" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   VerticalAlignment="Center" Click="PanelAiClick" AutomationProperties.Name="AI 검색">
      <StackPanel Orientation="Horizontal" Spacing="5">
       <Viewbox Width="12" Height="12" VerticalAlignment="Center">
        <Path x:Name="PanelAiSpark" Fill="{ThemeResource TextFillColorSecondaryBrush}" Data="M7,1.5 L8.4,5.6 12.5,7 8.4,8.4 7,12.5 5.6,8.4 1.5,7 5.6,5.6 Z M12.6,10.4 L13.2,12 14.8,12.6 13.2,13.2 12.6,14.8 12,13.2 10.4,12.6 12,12 Z"/>
       </Viewbox>
       <TextBlock Text="AI" FontSize="12" FontWeight="SemiBold"/>
      </StackPanel>
     </ToggleButton>
    </Grid>
    <Border x:Name="PanelSearchRing" CornerRadius="16" BorderThickness="2" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0" IsHitTestVisible="False"/>
   </Grid>
   <Border Grid.Column="1" Height="32" CornerRadius="16" Padding="4,0" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
    <StackPanel x:Name="PanelTabsHost" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
     <Button Style="{StaticResource PanelRoundButton}" Width="24" Height="24" CornerRadius="12" Click="AddCategoryClick"
             ToolTipService.ToolTip="모음 추가" AutomationProperties.Name="모음 추가">
      <FontIcon Glyph="&#xE710;" FontSize="11"/>
     </Button>
    </StackPanel>
   </Border>
   <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
    <Button x:Name="PanelPausedChip" Visibility="Collapsed" Style="{StaticResource PanelRoundButton}" Width="Auto" Height="24" CornerRadius="12" Padding="9,0,10,0" Margin="0,0,6,0"
            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" Foreground="{ThemeResource SystemFillColorCautionBrush}" Click="PauseClick"
            AutomationProperties.Name="기록 일시정지됨, 눌러서 재개" ToolTipService.ToolTip="눌러서 기록 재개">
     <StackPanel Orientation="Horizontal" Spacing="6">
      <Ellipse Width="6" Height="6" Fill="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center"/>
      <TextBlock Text="기록 일시정지됨" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
     </StackPanel>
    </Button>
    <Button x:Name="PanelFilterButton" Style="{StaticResource PanelRoundButton}" Click="FiltersClick" AutomationProperties.Name="복사한 앱, 날짜, 형식 필터" ToolTipService.ToolTip="필터">
     <Grid Width="16" Height="16">
      <FontIcon Glyph="&#xE71C;" FontSize="14"/>
      <Ellipse x:Name="PanelFilterDot" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-2,0" Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed"/>
     </Grid>
    </Button>
    <Button x:Name="PanelPauseButton" Style="{StaticResource PanelRoundButton}" Click="PauseClick" AutomationProperties.Name="기록 일시정지">
     <FontIcon x:Name="PanelPauseGlyph" Glyph="&#xE769;" FontSize="14"/>
    </Button>
    <Button Style="{StaticResource PanelRoundButton}" Click="PanelMoreClick" AutomationProperties.Name="더 보기: 설정, 메인 창 열기" ToolTipService.ToolTip="더 보기">
     <FontIcon Glyph="&#xE712;" FontSize="14"/>
    </Button>
   </StackPanel>
  </Grid>
  <Grid x:Name="Toolbar" Grid.Row="1" ColumnSpacing="12" Margin="0,0,0,8">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="Auto"/><ColumnDefinition x:Name="SearchColumn" Width="360"/><ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
   </Grid.ColumnDefinitions>
   <Grid Grid.Column="1">
    <TextBox x:Name="Query" PlaceholderText="기록 검색" TextChanged="QueryChanged" KeyDown="QueryKeyDown" Padding="11,5,64,6" MaxLength="4000"
             AutomationProperties.Name="클립보드 검색어" AutomationProperties.HelpText="Enter 검색, Shift+Enter AI 검색, Ctrl+F 검색창으로 이동"/>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False">
     <TextBlock Text="Ctrl+F" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
     <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
   </Grid>
   <Border Grid.Column="2" Padding="2" CornerRadius="5" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
           BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal" Spacing="2">
     <Grid>
      <Button x:Name="NormalModeButton" Click="NormalModeClick" Padding="12,3" CornerRadius="4" BorderThickness="0" AutomationProperties.Name="일반 검색">
       <TextBlock Text="일반" FontSize="13"/>
      </Button>
      <Rectangle x:Name="NormalPill" Width="12" Height="3" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Bottom" Margin="0,0,0,1" Fill="{ThemeResource AccentFillColorDefaultBrush}" IsHitTestVisible="False"/>
     </Grid>
     <Grid>
      <Button x:Name="AiModeButton" Click="AiModeClick" Padding="12,3" CornerRadius="4" BorderThickness="0" AutomationProperties.Name="AI 검색">
       <StackPanel Orientation="Horizontal" Spacing="6">
        <Viewbox Width="12" Height="12" VerticalAlignment="Center">
         <Path Fill="{ThemeResource TextFillColorPrimaryBrush}" Data="M7,1.5 L8.4,5.6 12.5,7 8.4,8.4 7,12.5 5.6,8.4 1.5,7 5.6,5.6 Z M12.6,10.4 L13.2,12 14.8,12.6 13.2,13.2 12.6,14.8 12,13.2 10.4,12.6 12,12 Z"/>
        </Viewbox>
        <TextBlock Text="AI 검색" FontSize="13"/>
       </StackPanel>
      </Button>
      <Rectangle x:Name="AiPill" Width="12" Height="3" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Bottom" Margin="0,0,0,1" Fill="{ThemeResource AccentFillColorDefaultBrush}" IsHitTestVisible="False" Opacity="0"/>
     </Grid>
    </StackPanel>
   </Border>
   <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
    <Button x:Name="SearchButton" Content="검색" Click="SearchClick" Visibility="Collapsed" Style="{ThemeResource AccentButtonStyle}"/>
    <Button x:Name="CancelButton" Content="취소" Click="CancelClick" Visibility="Collapsed"/>
    <Button x:Name="FilterButton" Click="FiltersClick" AutomationProperties.Name="복사한 앱, 날짜, 형식 필터">
     <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE71C;" FontSize="14"/><TextBlock x:Name="FilterLabel" Text="필터"/></StackPanel>
    </Button>
   </StackPanel>
  </Grid>
  <Grid x:Name="TabsRow" Grid.Row="2" ColumnSpacing="4" Margin="0,0,0,8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <SelectorBar x:Name="CategoryTabs" SelectionChanged="CategoryChanged" AutomationProperties.Name="클립보드 모음"/>
   <Button Grid.Column="1" Style="{StaticResource SubtleIconButton}" Width="32" Height="32" Click="AddCategoryClick"
           ToolTipService.ToolTip="모음 추가" AutomationProperties.Name="모음 추가" VerticalAlignment="Center">
    <FontIcon Glyph="&#xE710;" FontSize="12"/>
   </Button>
  </Grid>
  <StackPanel x:Name="AnswerRow" Grid.Row="3">
   <ProgressBar x:Name="Searching" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,6"/>
   <Border x:Name="AnswerContainer" Visibility="Collapsed" Padding="14,10" Margin="0,0,0,10" CornerRadius="4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
    <Border.Background><SolidColorBrush Color="{ThemeResource SystemAccentColor}" Opacity="0.1"/></Border.Background>
    <Grid ColumnSpacing="12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Viewbox Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0">
      <Path Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" Data="M7,1.5 L8.4,5.6 12.5,7 8.4,8.4 7,12.5 5.6,8.4 1.5,7 5.6,5.6 Z M12.6,10.4 L13.2,12 14.8,12.6 13.2,13.2 12.6,14.8 12,13.2 10.4,12.6 12,12 Z"/>
     </Viewbox>
     <ScrollViewer Grid.Column="1" MaxHeight="64" VerticalScrollBarVisibility="Auto">
      <TextBlock x:Name="Answer" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="13" AutomationProperties.LiveSetting="Polite"/>
     </ScrollViewer>
     <Button Grid.Column="2" Content="일반 검색으로" Style="{StaticResource SubtleTextButton}" Click="NormalModeClick" VerticalAlignment="Top" FontSize="13" Padding="8,3"/>
    </Grid>
   </Border>
  </StackPanel>
  <Grid Grid.Row="4">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <!-- The quick panel shows the AI answer as the first card so the panel height never changes. -->
   <Grid x:Name="PanelAnswerCard" Visibility="Collapsed" Width="300" Margin="0,0,12,0" Padding="11" RowSpacing="8" CornerRadius="8" BorderThickness="1"
         Background="{ThemeResource PanelAccentSoftBrush}" BorderBrush="{ThemeResource PanelAccentStrokeBrush}">
    <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition/><RowDefinition Height="24"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Spacing="8">
     <Grid Width="14" Height="14" VerticalAlignment="Center">
      <Viewbox x:Name="PanelAnswerSpark">
       <Path Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" Data="M7,1.5 L8.4,5.6 12.5,7 8.4,8.4 7,12.5 5.6,8.4 1.5,7 5.6,5.6 Z M12.6,10.4 L13.2,12 14.8,12.6 13.2,13.2 12.6,14.8 12,13.2 10.4,12.6 12,12 Z"/>
      </Viewbox>
      <ProgressRing x:Name="PanelAnswerProgress" Width="14" Height="14" MinWidth="0" MinHeight="0" IsActive="False" Visibility="Collapsed"/>
     </Grid>
     <TextBlock x:Name="PanelAnswerTitle" Text="AI 답변" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
     <TextBlock x:Name="PanelAnswerText" FontSize="14" LineHeight="22" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite"/>
    </ScrollViewer>
    <Grid Grid.Row="2">
     <TextBlock x:Name="PanelAnswerMeta" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
     <Button Style="{StaticResource PanelRoundButton}" Width="Auto" Height="24" CornerRadius="12" Padding="10,0" HorizontalAlignment="Right"
             Background="{ThemeResource PanelAccentSoftBrush}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Click="PanelAnswerActionClick">
      <TextBlock x:Name="PanelAnswerAction" Text="일반 검색으로" FontSize="12" FontWeight="SemiBold"/>
     </Button>
    </Grid>
   </Grid>
   <GridView x:Name="Library" Grid.Column="1" SelectionMode="Single" IsItemClickEnabled="False" ItemTemplate="{StaticResource CardTemplate}"
             ItemContainerStyle="{StaticResource CardContainer}" Padding="0,0,0,12" AutomationProperties.Name="클립보드 기록">
    <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid x:Name="LibraryPanel" Orientation="Horizontal" ItemHeight="188"/></ItemsPanelTemplate></GridView.ItemsPanel>
    <GridView.GroupStyle>
     <GroupStyle HidesIfEmpty="True">
      <GroupStyle.HeaderTemplate>
       <DataTemplate x:DataType="local:ClipGroup"><TextBlock Text="{x:Bind Key}" Style="{StaticResource BodyStrongTextBlockStyle}"/></DataTemplate>
      </GroupStyle.HeaderTemplate>
     </GroupStyle>
    </GridView.GroupStyle>
   </GridView>
   <!-- Padding leaves room for the selection ring, which sits 4 px outside each card.
        The scrollbar stays hidden because it would overlay the ring and card footers;
        the wheel (HistoryWheelChanged), touchpad and arrow keys still scroll. -->
   <ListView x:Name="History" Grid.Column="1" Visibility="Collapsed" SelectionMode="Single" IsItemClickEnabled="False"
             ItemTemplate="{StaticResource PanelCardTemplate}" ItemContainerStyle="{StaticResource PanelCardContainer}" SelectionChanged="HistorySelectionChanged"
             ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
             ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" Padding="4" Margin="-4,-4,0,-4"
             AutomationProperties.Name="클립보드 카드 목록">
    <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
   </ListView>
   <StackPanel x:Name="EmptyState" Grid.Column="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="480">
    <FontIcon Glyph="&#xE77F;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
    <TextBlock x:Name="EmptyLabel" Text="복사한 기록이 없습니다." HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}"/>
    <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource CardDescription}"/>
   </StackPanel>
   <Border x:Name="PanelToast" Grid.ColumnSpan="2" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,12,8"
           Height="36" CornerRadius="18" Padding="12,0,16,0" BorderThickness="1"
           Background="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
    <Border.OpacityTransition><ScalarTransition/></Border.OpacityTransition>
    <StackPanel Orientation="Horizontal" Spacing="10">
     <FontIcon x:Name="PanelToastGlyph" Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <TextBlock x:Name="PanelToastText" FontSize="13" MaxWidth="720" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
   </Border>
  </Grid>
  <Grid x:Name="StatusLine" Grid.Row="5" Height="40" Margin="-36,0" Padding="36,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" ColumnSpacing="8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Ellipse x:Name="RecordDot" Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource SystemFillColorSuccessBrush}"/>
   <TextBlock x:Name="StatusText" Grid.Column="1" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
   <StackPanel x:Name="KeyHints" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"/>
  </Grid>
 </Grid>
 </Border>
</UserControl>
