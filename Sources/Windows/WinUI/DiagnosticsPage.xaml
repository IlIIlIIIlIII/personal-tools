<UserControl x:Class="PersonalTools.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="1000" Margin="36,28,36,32" Spacing="16">
      <Grid>
        <TextBlock Text="진단" Style="{StaticResource PageTitle}"/>
        <Button HorizontalAlignment="Right" Style="{StaticResource SubtleTextButton}" Click="RefreshClick">
          <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="14"/><TextBlock Text="새로 고침"/></StackPanel>
        </Button>
      </Grid>
      <InfoBar x:Name="MessageBar" IsOpen="False" IsClosable="True"/>
      <Grid x:Name="Cards" ColumnSpacing="12" RowSpacing="12" SizeChanged="CardsSizeChanged">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="SecondColumn"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border x:Name="AudioCard" Style="{StaticResource Card}" Padding="18,16">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE767;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="오디오 효과" Style="{StaticResource BodyStrongTextBlockStyle}"/></StackPanel>
            <StackPanel x:Name="AudioRows" Spacing="8"/>
          </StackPanel>
        </Border>
        <Border x:Name="ClipboardCard" Grid.Column="1" Style="{StaticResource Card}" Padding="18,16">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE77F;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="클립보드" Style="{StaticResource BodyStrongTextBlockStyle}"/></StackPanel>
            <StackPanel x:Name="ClipboardRows" Spacing="8"/>
          </StackPanel>
        </Border>
        <Border x:Name="SwitchCard" Grid.Row="1" Style="{StaticResource Card}" Padding="18,16">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE7C4;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="창 빠른 전환" Style="{StaticResource BodyStrongTextBlockStyle}"/></StackPanel>
            <StackPanel x:Name="SwitchRows" Spacing="8"/>
          </StackPanel>
        </Border>
        <Border x:Name="BridgeCard" Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="18,16">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE774;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="Antigravity 브릿지" Style="{StaticResource BodyStrongTextBlockStyle}"/></StackPanel>
            <StackPanel x:Name="BridgeRows" Spacing="8"/>
          </StackPanel>
        </Border>
      </Grid>

      <StackPanel Spacing="4">
        <TextBlock Text="오디오 효과 설치" Style="{StaticResource GroupHeader}" Margin="0,8,0,4"/>
        <Border Style="{StaticResource SettingCard}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE7B8;" FontSize="20"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock x:Name="InstallTitle" Text="설치 전"/>
              <TextBlock x:Name="InstallDetail" Style="{StaticResource CardDescription}"/>
            </StackPanel>
            <Button x:Name="RestoreButton" Grid.Column="2" Content="원래 설정 복원" Click="Restore" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <Border Style="{StaticResource SettingCard}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE895;" FontSize="20"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="출력 장치 자동 복구"/>
              <TextBlock x:Name="RecoveryDetail" Style="{StaticResource CardDescription}" Text="설치하면 1분마다 같은 하드웨어를 찾아 다시 연결합니다."/>
            </StackPanel>
            <Border Grid.Column="2" Style="{StaticResource StatusPill}" VerticalAlignment="Center" Padding="10,3">
              <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse x:Name="RecoveryDot" Width="8" Height="8"/><TextBlock x:Name="RecoveryState" FontSize="12"/></StackPanel>
            </Border>
          </Grid>
        </Border>
      </StackPanel>

      <StackPanel Spacing="4">
        <Grid Margin="0,8,0,4">
          <TextBlock Text="최근 기록" Style="{StaticResource GroupHeader}" Margin="0" VerticalAlignment="Center"/>
          <Button HorizontalAlignment="Right" Style="{StaticResource SubtleTextButton}" Click="OpenLogFolder" Padding="8,4">
            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE838;" FontSize="13"/><TextBlock Text="기록 폴더 열기" FontSize="13"/></StackPanel>
          </Button>
        </Grid>
        <Border Style="{StaticResource Card}" Padding="0,4">
          <StackPanel x:Name="LogRows"/>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
