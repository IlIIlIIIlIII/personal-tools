<UserControl x:Class="PersonalTools.LightingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <!-- Theme brushes go through styles so a Windows theme change repaints them. -->
    <Style x:Key="DimText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Style>
    <Style x:Key="DimIcon" TargetType="FontIcon">
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Style>
    <Style x:Key="ZoneRow" TargetType="Grid">
      <Setter Property="MinHeight" Value="52"/>
      <Setter Property="ColumnSpacing" Value="16"/>
      <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
      <Setter Property="BorderThickness" Value="0,1,0,0"/>
    </Style>
    <Style x:Key="FirstZoneRow" TargetType="Grid">
      <Setter Property="MinHeight" Value="52"/>
      <Setter Property="ColumnSpacing" Value="16"/>
    </Style>
    <Style x:Key="LegendDot" TargetType="Ellipse">
      <Setter Property="Width" Value="10"/>
      <Setter Property="Height" Value="10"/>
      <Setter Property="StrokeThickness" Value="0.5"/>
      <Setter Property="Stroke" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="AccentLegendDot" TargetType="Ellipse" BasedOn="{StaticResource LegendDot}">
      <Setter Property="Fill" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
    </Style>
    <!-- Round color swatch: the ring (BorderBrush) marks the chosen color, Foreground outlines the fill. -->
    <Style x:Key="SwatchButton" TargetType="Button">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Ellipse Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2"/>
              <Ellipse Margin="4" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="LightSwatchButton" TargetType="Button" BasedOn="{StaticResource SwatchButton}">
      <Setter Property="Foreground" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}"/>
    </Style>
    <Style x:Key="ChosenSwatchButton" TargetType="Button" BasedOn="{StaticResource SwatchButton}">
      <Setter Property="BorderBrush" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
    </Style>
    <Style x:Key="ChosenLightSwatchButton" TargetType="Button" BasedOn="{StaticResource LightSwatchButton}">
      <Setter Property="BorderBrush" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
    </Style>
    <Style x:Key="MoreSwatchButton" TargetType="Button" BasedOn="{StaticResource LightSwatchButton}">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </UserControl.Resources>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="1000" Margin="36,28,36,32" Spacing="16">
      <Grid>
        <TextBlock Text="조명" Style="{StaticResource PageTitle}"/>
        <Border Style="{StaticResource StatusPill}" HorizontalAlignment="Right" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse x:Name="StateDot" Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource TextFillColorTertiaryBrush}"/>
            <Ellipse x:Name="StateDotOk" Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource SystemFillColorSuccessBrush}" Visibility="Collapsed"/>
            <TextBlock x:Name="StateText" Text="확인 중" FontSize="12"/>
          </StackPanel>
        </Border>
      </Grid>
      <TextBlock Style="{StaticResource Lead}" Text="키보드, 앞쪽 라이트바, 덮개 로고의 조명을 노트북에 저장합니다. 앱을 닫거나 Windows를 다시 시작해도 그대로입니다."/>
      <!-- Collapsed while closed so they do not add StackPanel spacing. -->
      <InfoBar x:Name="WindowsBar" IsOpen="False" IsClosable="False" Severity="Warning" Visibility="Collapsed"
               Title="Windows 동적 조명이 이 노트북 조명을 쓰고 있습니다."
               Message="지금은 Windows 동적 조명의 색이 보이고, 여기서 고른 효과는 저장만 됩니다. 이 노트북에서만 동적 조명을 끄면 바로 보입니다. 마우스 같은 다른 동적 조명 장치는 그대로입니다.">
        <InfoBar.ActionButton>
          <Button x:Name="WindowsOffButton" Content="이 노트북에서 동적 조명 끄기" Click="WindowsOffClick"/>
        </InfoBar.ActionButton>
      </InfoBar>
      <InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="False" Severity="Error" Visibility="Collapsed"/>

      <Border Style="{StaticResource Card}">
        <StackPanel Spacing="14">
          <Viewbox MaxWidth="640" Stretch="Uniform" HorizontalAlignment="Center">
            <Canvas x:Name="Preview" Width="640" Height="200" AutomationProperties.Name="노트북 조명 미리 보기"/>
          </Viewbox>
          <VariableSizedWrapGrid x:Name="Legend" Orientation="Horizontal" HorizontalAlignment="Center" ItemHeight="24" ItemWidth="220"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource SettingCard}">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <FontIcon x:Name="BrightnessIcon" Glyph="&#xE706;" FontSize="20"/>
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock x:Name="BrightnessTitle" Text="밝기"/>
            <TextBlock x:Name="BrightnessDescription" Style="{StaticResource CardDescription}" Text="Fn + ↑/↓로 바꿔도 여기에 바로 보입니다. 0이면 키보드, 라이트바, 로고가 모두 꺼집니다."/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Slider x:Name="BrightnessSlider" Width="200" Minimum="0" Maximum="9" StepFrequency="1" TickFrequency="1" SnapsTo="StepValues"
                    IsEnabled="False" ValueChanged="BrightnessChanged" AutomationProperties.Name="밝기"/>
            <TextBlock x:Name="BrightnessValue" Text="" MinWidth="14" TextAlignment="Right" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border Style="{StaticResource SettingCard}">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <FontIcon x:Name="ProfileIcon" Glyph="&#xE81E;" FontSize="20"/>
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock x:Name="ProfileTitle" Text="프로필"/>
            <TextBlock Style="{StaticResource CardDescription}" Text="Fn + Space를 누르면 1~6이 차례로 바뀝니다. 아래 구역 설정은 지금 프로필에 저장됩니다."/>
          </StackPanel>
          <ComboBox x:Name="ProfileBox" Grid.Column="2" MinWidth="120" VerticalAlignment="Center" IsEnabled="False"
                    SelectionChanged="ProfileChanged" AutomationProperties.Name="프로필">
            <ComboBoxItem Content="프로필 1"/>
            <ComboBoxItem Content="프로필 2"/>
            <ComboBoxItem Content="프로필 3"/>
            <ComboBoxItem Content="프로필 4"/>
            <ComboBoxItem Content="프로필 5"/>
            <ComboBoxItem Content="프로필 6"/>
          </ComboBox>
        </Grid>
      </Border>

      <StackPanel Spacing="4">
        <Grid Margin="0,8,0,4" MinHeight="32">
          <TextBlock Text="구역" Style="{StaticResource GroupHeader}" Margin="0" VerticalAlignment="Center"/>
          <Button x:Name="ResetButton" HorizontalAlignment="Right" IsEnabled="False" Click="ResetClick"
                  ToolTipService.ToolTip="이 프로필의 세 구역을 Lenovo 공장 설정으로 되돌립니다. 다른 프로필은 그대로입니다.">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE72C;" FontSize="14"/>
              <TextBlock x:Name="ResetText" Text="공장 설정으로"/>
            </StackPanel>
          </Button>
        </Grid>
        <StackPanel x:Name="ZoneList" Spacing="4"/>
        <TextBlock x:Name="ZonesPending" Style="{StaticResource Muted}" Text="노트북 조명을 읽고 있습니다."/>
      </StackPanel>
      <!-- The power button shows the performance mode; the user keeps it out of this page (2026-10-30). -->
      <TextBlock Style="{StaticResource CardDescription}" Text="전원 버튼 불은 성능 모드를 보여 주므로 여기서 바꾸지 않습니다. 충전 표시등, 카메라 표시등, Esc의 Fn 잠금 표시등은 노트북이 직접 정합니다."/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
