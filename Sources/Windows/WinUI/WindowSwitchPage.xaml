<UserControl x:Class="PersonalTools.WindowSwitchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="1000" Margin="36,28,36,32" Spacing="16">
      <Grid>
        <TextBlock Text="창 빠른 전환" Style="{StaticResource PageTitle}"/>
        <Border Style="{StaticResource StatusPill}" HorizontalAlignment="Right" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse x:Name="CountDot" Width="8" Height="8" Fill="{ThemeResource SystemFillColorSuccessBrush}"/>
            <TextBlock x:Name="CountText" Text="0 / 8 등록" FontSize="12"/>
          </StackPanel>
        </Border>
      </Grid>
      <TextBlock Text="자주 쓰는 창을 키에 등록해 두고 단축키 한 번으로 돌아갑니다." Style="{StaticResource Lead}"/>
      <InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="False" Severity="Error" Title="단축키를 사용할 수 없습니다"/>
      <Border Style="{StaticResource SettingCard}">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE7C4;" FontSize="20"/>
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="창 빠른 전환 사용"/>
            <TextBlock Style="{StaticResource CardDescription}" Text="켜 두면 Win+1~4는 작업 표시줄 앱 대신, Win+Q·W·E·R은 검색·위젯·파일 탐색기·실행 대신 이 기능으로 동작합니다."/>
          </StackPanel>
          <ToggleSwitch x:Name="EnabledSwitch" Grid.Column="2" OnContent="켬" OffContent="끔" Toggled="EnabledToggled"
                        AutomationProperties.Name="창 빠른 전환 사용" MinWidth="0"/>
        </Grid>
      </Border>
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource HintTile}">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <StackPanel x:Name="RegisterKeys" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"/>
            <TextBlock Text="지금 보고 있는 창을 등록" Style="{StaticResource CardDescription}" FontSize="13" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource HintTile}">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <StackPanel x:Name="FocusKeys" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"/>
            <TextBlock Text="등록한 창으로 전환" Style="{StaticResource CardDescription}" FontSize="13" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
      </Grid>
      <Grid x:Name="NumberRow" ColumnSpacing="12" Margin="0,0,32,0" AutomationProperties.Name="숫자 키 1~4">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      </Grid>
      <Grid x:Name="LetterRow" ColumnSpacing="12" Margin="32,-4,0,0" AutomationProperties.Name="문자 키 Q W E R">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      </Grid>
      <TextBlock Style="{StaticResource Footnote}" Text="창을 닫으면 그 키는 비워집니다. 같은 키에 다시 등록하면 새 창으로 바뀝니다. 등록은 Personal Tools를 종료하거나 로그아웃할 때까지 유지됩니다. 관리자 권한으로 실행한 창이 앞에 있을 때는 단축키가 동작하지 않을 수 있습니다."/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
