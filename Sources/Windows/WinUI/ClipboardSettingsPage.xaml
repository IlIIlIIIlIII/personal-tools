<UserControl x:Class="PersonalTools.ClipboardSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="1000" Margin="36,28,36,32" Spacing="16">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Click="BackClick" Style="{StaticResource SubtleTextButton}" Padding="4,0" AutomationProperties.Name="클립보드로 돌아가기">
          <TextBlock Text="클립보드" Style="{StaticResource TitleTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Button>
        <FontIcon Glyph="&#xE76C;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
        <TextBlock Text="설정" Style="{StaticResource PageTitle}"/>
      </StackPanel>
      <InfoBar x:Name="MessageBar" IsOpen="False" IsClosable="True"/>

      <StackPanel Spacing="4">
        <TextBlock Text="기록" Style="{StaticResource GroupHeader}" Margin="0,8,0,4"/>
        <Border Style="{StaticResource SettingCard}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE81C;" FontSize="20"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="클립보드 기록 저장"/>
              <TextBlock Style="{StaticResource CardDescription}" Text="복사한 텍스트, 이미지, 파일을 자동으로 보관합니다."/>
            </StackPanel>
            <ToggleSwitch x:Name="RecordSwitch" Grid.Column="2" OnContent="켬" OffContent="끔" MinWidth="0" Toggled="RecordToggled" AutomationProperties.Name="클립보드 기록 저장"/>
          </Grid>
        </Border>
        <Border Style="{StaticResource SettingCard}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE765;" FontSize="20"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="빠른 패널 단축키"/>
              <TextBlock Style="{StaticResource CardDescription}" Text="어느 앱에서든 클립보드 패널을 엽니다."/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <StackPanel x:Name="HotkeyKeys" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"/>
              <Button Content="변경" Click="ChangeHotkey"/>
            </StackPanel>
          </Grid>
        </Border>
        <Border Style="{StaticResource SettingCard}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE72E;" FontSize="20"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="기록하지 않을 앱"/>
              <TextBlock Style="{StaticResource CardDescription}" Text="비밀번호 관리자처럼 내용을 보관하면 안 되는 앱입니다."/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <TextBlock x:Name="ExcludedSummary" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
              <Button Content="편집" Click="EditExcluded"/>
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Text="저장 공간" Style="{StaticResource GroupHeader}" Margin="0,8,0,4"/>
        <Border Style="{StaticResource SettingCard}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE8B7;" FontSize="20"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="저장 폴더"/>
              <TextBlock x:Name="ArchivePathText" Style="{StaticResource CardDescription}" FontFamily="Cascadia Mono, Consolas" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button x:Name="MoveButton" Grid.Column="2" Content="폴더 변경" Click="MoveArchive" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <Border Style="{StaticResource SettingCard}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE8F1;" FontSize="20"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
              <StackPanel Spacing="2">
                <TextBlock Text="보관 용량"/>
                <TextBlock x:Name="UsageText" Style="{StaticResource CardDescription}" Text="사용량 확인 중"/>
              </StackPanel>
              <ProgressBar x:Name="UsageBar" Maximum="1" Width="280" HorizontalAlignment="Left"/>
            </StackPanel>
            <ComboBox x:Name="TotalBox" Grid.Column="2" Width="120" VerticalAlignment="Center" SelectionChanged="LimitChanged" AutomationProperties.Name="전체 보관 용량"/>
          </Grid>
        </Border>
        <Border Style="{StaticResource SettingCard}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE8A5;" FontSize="20"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="항목당 최대 크기"/>
              <TextBlock Style="{StaticResource CardDescription}" Text="이보다 큰 항목은 보관하지 않습니다."/>
            </StackPanel>
            <ComboBox x:Name="ItemBox" Grid.Column="2" Width="120" VerticalAlignment="Center" SelectionChanged="LimitChanged" AutomationProperties.Name="항목당 최대 크기"/>
          </Grid>
        </Border>
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Text="AI 기능" Style="{StaticResource GroupHeader}" Margin="0,8,0,4"/>
        <Border Style="{StaticResource SettingCard}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Viewbox Width="20" Height="20" VerticalAlignment="Center">
              <Path Fill="{ThemeResource TextFillColorPrimaryBrush}" Data="M7,1.5 L8.4,5.6 12.5,7 8.4,8.4 7,12.5 5.6,8.4 1.5,7 5.6,5.6 Z M12.6,10.4 L13.2,12 14.8,12.6 13.2,13.2 12.6,14.8 12,13.2 10.4,12.6 12,12 Z"/>
            </Viewbox>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="AI 검색"/>
              <TextBlock Style="{StaticResource CardDescription}" Text="검색어와 선택한 탭의 기록을 Antigravity로 보내 파일 내용까지 찾습니다."/>
            </StackPanel>
            <ToggleSwitch x:Name="AiSwitch" Grid.Column="2" OnContent="켬" OffContent="끔" MinWidth="0" Toggled="AiToggled" AutomationProperties.Name="AI 검색"/>
          </Grid>
        </Border>
        <Border Style="{StaticResource SettingCard}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE91B;" FontSize="20"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="이미지 자동 태깅"/>
              <TextBlock Style="{StaticResource CardDescription}" Text="새 이미지를 분석해 일반 검색과 AI 검색에 쓸 태그를 저장합니다."/>
            </StackPanel>
            <ToggleSwitch x:Name="TagSwitch" Grid.Column="2" OnContent="켬" OffContent="끔" MinWidth="0" Toggled="TagToggled" AutomationProperties.Name="이미지 자동 태깅"/>
          </Grid>
        </Border>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="4">
        <TextBlock Style="{StaticResource Footnote}" Text="AI 기능은 Antigravity 브릿지에서 로그인한 계정의 사용량을 씁니다." VerticalAlignment="Center"/>
        <HyperlinkButton Content="연결 설정 열기" Click="OpenBridge" FontSize="12" Padding="4,2"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
