<UserControl x:Class="PersonalTools.HdrPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="1000" Margin="36,28,36,32" Spacing="16">
      <Grid>
        <TextBlock Text="자동 HDR" Style="{StaticResource PageTitle}"/>
        <Border Style="{StaticResource StatusPill}" HorizontalAlignment="Right" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse x:Name="StateDot" Width="8" Height="8" Fill="{ThemeResource TextFillColorTertiaryBrush}"/>
            <TextBlock x:Name="StateText" Text="확인 중" FontSize="12"/>
          </StackPanel>
        </Border>
      </Grid>
      <TextBlock Text="게임이나 등록한 프로그램이 실행되면 주 모니터의 HDR을 켜고, 모두 종료되면 원래대로 되돌립니다." Style="{StaticResource Lead}"/>
      <!-- Collapsed while closed so they do not add StackPanel spacing. -->
      <InfoBar x:Name="Status" IsOpen="False" IsClosable="False" Severity="Warning" Visibility="Collapsed"/>
      <InfoBar x:Name="ActionError" IsOpen="False" IsClosable="True" Severity="Error" Visibility="Collapsed" Closed="ActionErrorClosed"/>

      <Border Style="{StaticResource SettingCard}">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE706;" FontSize="20"/>
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="자동 HDR 사용"/>
            <TextBlock Style="{StaticResource CardDescription}" Text="끄면 게임이나 등록한 프로그램을 실행해도 HDR을 바꾸지 않습니다."/>
          </StackPanel>
          <ToggleSwitch x:Name="EnabledSwitch" Grid.Column="2" OnContent="켬" OffContent="끔" MinWidth="0" IsEnabled="False" Toggled="EnabledToggled"
                        AutomationProperties.Name="자동 HDR 사용"/>
        </Grid>
      </Border>

      <StackPanel Spacing="4">
        <TextBlock Text="적용할 모니터" Style="{StaticResource GroupHeader}" Margin="0,8,0,4"/>
        <Border Style="{StaticResource SettingCard}">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE7F4;" FontSize="20"/>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock x:Name="MonitorTitle" Text="주 모니터 확인 중" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="MonitorDetail" Style="{StaticResource CardDescription}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <Border x:Name="MonitorBadge" CornerRadius="4" Padding="6,1,6,2" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="MonitorBadgeText" FontSize="11" FontWeight="SemiBold"/>
              </Border>
              <ToggleSwitch x:Name="MonitorSwitch" OnContent="켬" OffContent="끔" MinWidth="0" IsEnabled="False" Toggled="MonitorToggled"
                            AutomationProperties.Name="주 모니터 HDR"/>
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Text="설치된 게임" Style="{StaticResource GroupHeader}" Margin="0,8,0,4"/>
        <StackPanel>
          <Border x:Name="GamesHeader" Style="{StaticResource SettingCard}" CornerRadius="4,4,0,0">
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE7FC;" FontSize="20"/>
              <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="설치된 게임 자동 적용"/>
                <TextBlock x:Name="GamesDetail" Style="{StaticResource CardDescription}" TextWrapping="WrapWholeWords"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <ToggleSwitch x:Name="GamesSwitch" OnContent="켬" OffContent="끔" MinWidth="0" IsEnabled="False" Toggled="GamesToggled"
                              AutomationProperties.Name="설치된 게임 자동 적용"/>
                <Button x:Name="GamesExpand" Style="{StaticResource SubtleIconButton}" Width="32" Height="32" Click="GamesExpandClick">
                  <FontIcon x:Name="GamesChevron" Glyph="&#xE70E;" FontSize="12"/>
                </Button>
              </StackPanel>
            </Grid>
          </Border>
          <!-- Rows indent to the header text and leave the chevron's gutter, so their switches line up with the header switch. -->
          <Border x:Name="GamesBody" Style="{StaticResource ExpanderBody}" Padding="0">
            <StackPanel>
              <Grid x:Name="GamesMeta" Padding="52,8,60,8" MinHeight="48">
                <TextBlock x:Name="GamesSummary" Style="{StaticResource CardDescription}" VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SubtleTextButton}" Padding="10,4" Click="RescanClick"
                        AutomationProperties.Name="게임 다시 검색">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                    <TextBlock Text="다시 검색" FontSize="13"/>
                  </StackPanel>
                </Button>
              </Grid>
              <StackPanel x:Name="GamesList"/>
              <StackPanel x:Name="GamesEmpty" Padding="52,16,60,18" Spacing="4" Visibility="Collapsed">
                <TextBlock Text="설치된 게임을 찾지 못했습니다" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource Muted}" TextWrapping="WrapWholeWords" Text="Steam, Ubisoft Connect, EA app, Epic Games, Xbox, GOG와 Windows 게임 바 기록을 확인했습니다. 게임을 설치하면 5분 안에 나타납니다."/>
                <Button Margin="0,8,0,0" Padding="10,4" Click="RescanClick" AutomationProperties.Name="게임 다시 검색">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                    <TextBlock Text="다시 검색" FontSize="13"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>

      <StackPanel Spacing="4">
        <Grid Margin="0,8,0,4" MinHeight="32">
          <TextBlock Text="직접 등록한 프로그램" Style="{StaticResource GroupHeader}" Margin="0" VerticalAlignment="Center"/>
          <Button x:Name="AddButton" HorizontalAlignment="Right" Style="{ThemeResource AccentButtonStyle}" Click="Add" Visibility="Collapsed" AutomationProperties.Name="프로그램 추가">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE710;" FontSize="14"/>
              <TextBlock Text="프로그램 추가"/>
            </StackPanel>
          </Button>
        </Grid>
        <StackPanel x:Name="Programs" Spacing="4"/>
        <!-- With games detected, an empty manual list is normal; the full empty state is for when nothing applies. -->
        <TextBlock x:Name="ManualHint" Style="{StaticResource Muted}" TextWrapping="WrapWholeWords" Visibility="Collapsed"
                   Text="직접 등록한 프로그램이 없습니다. 게임이 아닌 프로그램(HDR 동영상 플레이어 등)은 여기에 추가하세요."/>
        <Grid x:Name="EmptyState" Visibility="Collapsed">
          <Rectangle RadiusX="8" RadiusY="8" StrokeThickness="1" StrokeDashArray="4 3" Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}" Opacity="0.6"/>
          <StackPanel Padding="24,28,24,24" Spacing="6" HorizontalAlignment="Center">
            <FontIcon Glyph="&#xE7FC;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
            <TextBlock Text="등록한 프로그램이 없습니다" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <!-- Two sentences on their own lines: Korean wraps between syllables, not words. -->
            <TextBlock Text="게임이나 HDR 동영상 플레이어의 실행 파일을 추가하세요." Style="{StaticResource Muted}" FontSize="14" TextAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock Text="실행되면 주 모니터의 HDR을 켭니다." Style="{StaticResource Muted}" FontSize="14" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,-4,0,0"/>
            <Button HorizontalAlignment="Center" Margin="0,10,0,0" Style="{ThemeResource AccentButtonStyle}" Click="Add" AutomationProperties.Name="프로그램 추가">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE710;" FontSize="14"/>
                <TextBlock Text="프로그램 추가"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </StackPanel>

      <TextBlock Style="{StaticResource Footnote}" TextWrapping="WrapWholeWords" Text="게임 폴더 안의 프로그램이 실행되면 켜므로 게임 전용 런처에서도 바로 적용합니다. Steam, Ubisoft Connect 같은 공용 런처는 제외합니다. 게임이 아닌 프로그램(HDR 동영상 플레이어 등)은 직접 등록하세요. 게임 중 직접 바꾼 HDR 설정은 종료 뒤에도 유지합니다. 창을 닫아도 트레이에서 계속 감지합니다."/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
