<UserControl x:Class="PersonalTools.HdrPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch" Margin="32,28,32,32" Spacing="20">
      <TextBlock Text="디스플레이 · HDR" Style="{ThemeResource TitleTextBlockStyle}"/>
      <TextBlock Text="게임 실행을 감지해 현재 주 모니터의 HDR을 켜고, 종료하면 이전 상태로 복원합니다. 게임 창 위치는 변경하지 않습니다." TextWrapping="Wrap"/>
      <InfoBar x:Name="Status" IsOpen="False" IsClosable="True" Severity="Warning"/>
      <Border Style="{StaticResource Card}">
        <StackPanel Spacing="10">
          <TextBlock Text="화면 꺼짐 방지" Style="{StaticResource SectionTitle}"/>
          <TextBlock x:Name="PowerSummary" Text="조회 시작 필요" FontWeight="SemiBold"/>
          <TextBlock x:Name="PowerDetail" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
          <Button x:Name="PowerStart" Content="관리자 권한으로 조회 시작" Click="StartPowerQuery"/>
          <TextBlock Text="Windows의 DISPLAY 전원 요청을 5초마다 확인합니다. 관리자 승인은 앱 실행마다 한 번 필요합니다. 전원 설정·사용자 입력·요청 무시 설정에 따라 실제 화면 꺼짐 여부는 달라질 수 있습니다." Style="{StaticResource Muted}"/>
        </StackPanel>
      </Border>
      <TextBlock Text="모니터" Style="{StaticResource SectionTitle}"/>
      <StackPanel x:Name="Monitors" Spacing="10"/>
      <TextBlock Text="게임 중 직접 변경한 HDR 설정은 게임 종료 후에도 유지됩니다." Style="{StaticResource Muted}"/>
      <TextBlock Text="자동 HDR 프로그램" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="Steam 같은 런처 대신 실제 게임 실행 파일을 등록하세요. 실행 직후 감지하므로 게임의 HDR 설정에 따라 다시 실행해야 할 수 있습니다." Style="{StaticResource Muted}"/>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="실행 파일 추가" Click="AddFile" Style="{ThemeResource AccentButtonStyle}"/>
        <Button Content="실행 중인 프로그램 추가" Click="AddRunning"/>
      </StackPanel>
      <StackPanel x:Name="Programs" Spacing="10"/>
      <TextBlock Text="Windows 위젯" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="HDR 위젯 패키지를 설치한 뒤 Win+W → 위젯 추가에서 Personal Tools HDR을 선택하세요. 각 모니터의 HDR을 켜거나 끌 수 있습니다." Style="{StaticResource Muted}"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
